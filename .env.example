# Copy to .env and fill in. Real environment variables take precedence over .env.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# app.settings.development locally, app.settings.production on the server
DJANGO_SETTINGS_MODULE=app.settings.development
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
# Comma-separated, scheme included, e.g. https://blog.example.com
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
DB_NAME=pyconza
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ---------------------------------------------------------------------------
# Production only (optional)
# ---------------------------------------------------------------------------
# Set to False if TLS is not terminated in front of Django (e.g. a local prod smoke test)
SECURE_SSL_REDIRECT=True
# HSTS max-age in seconds; start small, raise to 31536000 once HTTPS is confirmed
SECURE_HSTS_SECONDS=3600
